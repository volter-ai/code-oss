{
	"name": "supercode-frontend-vscode",
	"displayName": "Volter Harness",
	"version": "0.1.16",
	"type": "module",
	"description": "VS Code chat-view frontend for an existing Volter Harness SDK runtime",
	"publisher": "volter-ai-dev",
	"icon": "media/icon.png",
	"main": "./dist/extension.js",
	"exports": {
		"types": "./dist/index.d.ts",
		"import": "./dist/index.js"
	},
	"types": "./dist/index.d.ts",
	"engines": {
		"node": ">=20",
		"vscode": "^1.138.0"
	},
	"categories": [
		"Chat",
		"Other"
	],
	"extensionKind": [
		"workspace",
		"ui"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"enabledApiProposals": [
		"defaultChatParticipant",
		"chatParticipantPrivate",
		"chatParticipantAdditions",
		"chatSessionsProvider",
		"chatProvider"
	],
	"contributes": {
		"chatParticipants": [
			{
				"id": "supercode.chat",
				"name": "supercode",
				"fullName": "Assistant",
				"description": "Ask a question or describe a task",
				"when": "!supercodeChatDefaultParticipant",
				"sampleRequest": "list the files here"
			},
			{
				"id": "supercode.chat.default",
				"name": "supercode",
				"fullName": "Assistant",
				"description": "Ask a question or describe a task",
				"isDefault": true,
				"sampleRequest": "list the files here",
				"locations": [
					"panel"
				],
				"modes": [
					"agent",
					"ask"
				]
			}
		],
		"chatSessions": [
			{
				"type": "supercode",
				"name": "supercode-runtime",
				"displayName": "Harness",
				"description": "Conversations with your AI assistant",
				"icon": "$(server-process)",
				"welcomeTitle": "Chat",
				"welcomeMessage": "Write a message to your coding agent.",
				"inputPlaceholder": "Ask a question or describe a task",
				"order": 1,
				"capabilities": {
					"supportsFileAttachments": true,
					"supportsToolAttachments": false,
					"supportsImageAttachments": false
				},
				"canDelegate": false,
				"supportsAutoModel": false,
				"requiresCustomModels": true
			}
		],
		"chatViewsWelcome": [
			{
				"icon": "$(server-process)",
				"title": "Volter Harness",
				"content": "Volter Harness is not attached to a runtime.\n[Set runtime token](command:supercode.frontend.setToken)\n[Attach](command:supercode.frontend.connect)",
				"when": "!supercodeAttached"
			}
		],
		"commands": [
			{
				"command": "supercode.frontend.setToken",
				"title": "Set Runtime Token",
				"category": "Volter Harness"
			},
			{
				"command": "supercode.frontend.connect",
				"title": "Attach to Runtime",
				"category": "Volter Harness"
			},
			{
				"command": "supercode.frontend.disconnect",
				"title": "Detach from Runtime",
				"category": "Volter Harness"
			},
			{
				"command": "supercode.frontend.status",
				"title": "Show Runtime Status",
				"category": "Volter Harness"
			},
			{
				"command": "supercode.frontend.newSession",
				"title": "New Volter Harness Runtime Session",
				"category": "Volter Harness",
				"icon": "$(server-process)"
			},
			{
				"command": "supercode.frontend.respond",
				"title": "Answer Runtime Request",
				"category": "Volter Harness",
				"enablement": "false"
			},
			{
				"command": "supercode.frontend.configure",
				"title": "New Chat: Choose Harness, Model and Reasoning",
				"category": "Chat",
				"icon": "$(add)"
			}
		],
		"configuration": {
			"title": "Volter Harness",
			"properties": {
				"supercode.frontend.baseUrl": {
					"type": "string",
					"default": "",
					"description": "Base URL of an already-running Volter Harness SDK runtime (`supercode serve` prints it). The runtime credential is NEVER a setting — run `Volter Harness: Set Runtime Token`, which stores it in SecretStorage."
				},
				"supercode.frontend.permissions": {
					"type": "array",
					"default": [
						"observe"
					],
					"items": {
						"type": "string",
						"enum": [
							"observe",
							"interact",
							"approve",
							"terminate"
						]
					},
					"description": "Permissions to request when attaching. `observe` is always included; every control is still rendered only when the runtime's own descriptor advertises the matching action."
				}
			}
		},
		"menus": {
			"chatSessions/newSession": [
				{
					"command": "supercode.frontend.newSession",
					"when": "chatSessionType == supercode"
				}
			]
		},
		"languageModelChatProviders": [
			{
				"vendor": "supercode-runtime",
				"displayName": "Runtime models"
			}
		]
	},
	"supercodeFrontendWelcome": {
		"starterIntroduction": "Choose an idea to edit before sending:"
	},
	"supercodeFrontendContract": {
		"name": "@volter/supercode-frontend",
		"version": "0.2.7",
		"mode": "generated-artifact"
	},
	"license": "MIT OR Apache-2.0"
}
